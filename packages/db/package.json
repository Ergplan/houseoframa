{
  "name": "@rama/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and seed for House of Rama (Postgres 16).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "generate": "drizzle-kit generate",
    "check": "drizzle-kit check",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "pod": "tsx src/cli.ts pod"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
