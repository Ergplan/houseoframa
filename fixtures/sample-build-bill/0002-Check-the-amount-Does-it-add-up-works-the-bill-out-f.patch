+import { renderToStaticMarkup } from 'react-dom/server';
+import { expect, it } from 'vitest';
+import DoesItAddUp from './page';
+
+it('works the sample bill out and says it adds up, every amount a traced figure', async () => {
+  const html = renderToStaticMarkup(await DoesItAddUp());
+  expect(html).toContain('Does it add up?');
+  expect(html).toContain('It adds up');
+  for (const [id, v] of [
+    ['energy-charge', 275000],
+    ['fixed-charge', 11000],
+    ['electricity-duty', 14300],
+    ['worked-out-amount', 300300],
+    ['amount-payable', 300300],
+    ['difference', 0],
+  ] as const) {
+    expect(html).toContain(`data-rama-figure="${id}"`);
+    expect(html).toContain(`data-rama-value="${v}"`);
+  }
+  expect(html).toContain('₹2,750.00');
+});
