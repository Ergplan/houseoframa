@@ -0,0 +1,56 @@
+// Check the amount: what the bill should come to under the tariff, worked out from the units on the bill,
+// and how far the amount it asks for is from that. Every amount is in paise.
+import tariff from '../../data/tariff.json';
+import type { Bill } from '../read-the-bill/read';
+
+export interface Tariff {
+  slabs: { upTo: number | null; paisePerUnit: number }[];
+  fixedChargePaise: number;
+  dutyPercent: number;
+}
+
+export const TARIFF: Tariff = tariff;
+
+/** The energy charge: each slab's units at that slab's rate, added up. */
+export function energyCharge(bill: Bill, t: Tariff = TARIFF): number {
+  let left = bill.units ?? 0;
+  let from = 0;
+  let sum = 0;
+  for (const s of t.slabs) {
+    const room = s.upTo === null ? left : Math.min(left, s.upTo - from);
+    sum += room * s.paisePerUnit;
+    left -= room;
+    from = s.upTo ?? from;
+    if (left <= 0) break;
+  }
+  return sum;
+}
+
+/** The fixed charge for the month. */
+export const fixedCharge = (_bill: Bill, t: Tariff = TARIFF): number => t.fixedChargePaise;
+
+/** Electricity duty: the duty percent of the energy and fixed charges, rounded to the paisa. */
+export function electricityDuty(bill: Bill, t: Tariff = TARIFF): number {
+  return Math.round(((energyCharge(bill, t) + fixedCharge(bill, t)) * t.dutyPercent) / 100);
+}
+
+/** What the bill should come to: energy charge, fixed charge and duty. */
+export function workedOutAmount(bill: Bill, t: Tariff = TARIFF): number {
+  return energyCharge(bill, t) + fixedCharge(bill, t) + electricityDuty(bill, t);
+}
+
+/** How much more the bill asks for than it should (less when negative). */
+export function difference(bill: Bill, t: Tariff = TARIFF): number {
+  return (bill.amountPaise ?? 0) - workedOutAmount(bill, t);
+}
+
+/** Whether the bill adds up, in words. */
+export function verdict(bill: Bill, t: Tariff = TARIFF): string {
+  if (bill.units === null || bill.amountPaise === null)
+    return 'It cannot be checked: the bill does not show its units or its amount.';
+  const d = difference(bill, t);
+  if (d === 0) return 'It adds up: the bill asks for exactly what the tariff gives.';
+  return d > 0
+    ? 'It does not add up: the bill asks for more than the tariff gives.'
+    : 'It does not add up: the bill asks for less than the tariff gives.';
+}
