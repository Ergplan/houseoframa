+import { Figure } from '../../components/Figure';
+import { latestBill } from '../../db/bills';
+import {
+  TARIFF,
+  difference,
+  electricityDuty,
+  energyCharge,
+  fixedCharge,
+  verdict,
+  workedOutAmount,
+} from '../../features/check-the-amount/charge';
+import { amountPayable } from '../../features/read-the-bill/read';
+import tariff from '../../data/tariff.json';
+
+export const dynamic = 'force-dynamic';
+
+export default async function DoesItAddUp() {
+  const bill = await latestBill();
+  return (
+    <main>
+      <h1>{'Does it add up?'}</h1>
+      <p>{verdict(bill)}</p>
+      <p>Under: {tariff.name}</p>
+      <p>
+        Energy charge: <Figure id="energy-charge" fn={energyCharge} args={[bill, TARIFF]} show="rupees" />
+      </p>
+      <p>
+        Fixed charge: <Figure id="fixed-charge" fn={fixedCharge} args={[bill, TARIFF]} show="rupees" />
+      </p>
+      <p>
+        Electricity duty:{' '}
+        <Figure id="electricity-duty" fn={electricityDuty} args={[bill, TARIFF]} show="rupees" />
+      </p>
+      <p>
+        It should come to:{' '}
+        <Figure id="worked-out-amount" fn={workedOutAmount} args={[bill, TARIFF]} show="rupees" />
+      </p>
+      <p>
+        The bill asks for: <Figure id="amount-payable" fn={amountPayable} args={[bill]} show="rupees" />
+      </p>
+      <p>
+        Difference: <Figure id="difference" fn={difference} args={[bill, TARIFF]} show="rupees" />
+      </p>
+    </main>
+  );
+}
