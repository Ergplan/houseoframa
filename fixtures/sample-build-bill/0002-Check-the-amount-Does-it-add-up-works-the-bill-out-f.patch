+import { readFileSync } from 'node:fs';
+import { expect, it } from 'vitest';
+import { readBill } from '../read-the-bill/read';
+import { difference, electricityDuty, energyCharge, fixedCharge, verdict, workedOutAmount } from './charge';
+
+const bill = readBill(readFileSync('data/bill-sep-2026.pdf'));
+
+it('works the sample bill out slab by slab: it adds up', () => {
+  // 100 × 5.50 + 200 × 6.80 + 112 × 7.50 = 550 + 1,360 + 840
+  expect(energyCharge(bill)).toBe(275000);
+  expect(fixedCharge(bill)).toBe(11000);
+  expect(electricityDuty(bill)).toBe(14300);
+  expect(workedOutAmount(bill)).toBe(300300);
+  expect(difference(bill)).toBe(0);
+  expect(verdict(bill)).toMatch(/^It adds up/);
+});
+
+it('says when a bill asks for more, or less, than the tariff gives', () => {
+  expect(difference({ ...bill, amountPaise: 310000 })).toBe(9700);
+  expect(verdict({ ...bill, amountPaise: 310000 })).toMatch(/more than the tariff gives/);
+  expect(verdict({ ...bill, amountPaise: 290000 })).toMatch(/less than the tariff gives/);
+});
+
+it('charges units within the first slab at its rate only, and cannot check a bill without units', () => {
+  expect(energyCharge({ ...bill, units: 80 })).toBe(80 * 550);
+  expect(energyCharge({ ...bill, units: 0 })).toBe(0);
+  expect(verdict({ ...bill, units: null })).toMatch(/cannot be checked/);
+});
