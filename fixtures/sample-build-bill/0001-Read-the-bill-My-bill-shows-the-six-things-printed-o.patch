@@ -0,0 +1,64 @@
+// Read the bill: the six things printed on a bill, exactly as printed, picked out of its text. A thing
+// that is not on the bill is left empty rather than guessed, and the reader says which ones are missing.
+import { pdfLines } from '../../lib/pdf-text';
+
+export interface Bill {
+  consumerNo: string | null;
+  category: string | null;
+  /** The billing period as printed, day-month-year: from and to. */
+  periodFrom: string | null;
+  periodTo: string | null;
+  /** Units consumed, as printed. */
+  units: number | null;
+  /** Amount payable, in paise (100 paise make a rupee). */
+  amountPaise: number | null;
+  dueDate: string | null;
+}
+
+/** The value printed after a label, on the line that starts with it. */
+function after(lines: string[], label: string): string | null {
+  const line = lines.find((l) => l.toLowerCase().startsWith(label.toLowerCase()));
+  return line ? line.slice(label.length).trim() || null : null;
+}
+
+/** "Rs 3,003.00" in paise; null when it is not an amount. */
+export function paise(printed: string | null): number | null {
+  const m = printed?.match(/([\d,]+)(?:\.(\d{1,2}))?/);
+  if (!m) return null;
+  return Number(m[1]!.replace(/,/g, '')) * 100 + Number((m[2] ?? '0').padEnd(2, '0'));
+}
+
+/** The six things printed on the bill. */
+export function readBill(pdf: Buffer): Bill {
+  const lines = pdfLines(pdf);
+  const period = after(lines, 'Billing period')?.match(/(\S+)\s+to\s+(\S+)/) ?? null;
+  const units = after(lines, 'Units consumed');
+  return {
+    consumerNo: after(lines, 'Consumer No'),
+    category: after(lines, 'Category'),
+    periodFrom: period?.[1] ?? null,
+    periodTo: period?.[2] ?? null,
+    units: units && /^\d+$/.test(units.replace(/,/g, '')) ? Number(units.replace(/,/g, '')) : null,
+    amountPaise: paise(after(lines, 'Amount payable')),
+    dueDate: after(lines, 'Due date'),
+  };
+}
+
+/** The things the bill did not show, in plain words. */
+export function missing(b: Bill): string[] {
+  const names: [keyof Bill, string][] = [
+    ['consumerNo', 'the consumer number'],
+    ['category', 'the category'],
+    ['periodFrom', 'the billing period'],
+    ['units', 'the units consumed'],
+    ['amountPaise', 'the amount payable'],
+    ['dueDate', 'the due date'],
+  ];
+  return names.filter(([k]) => b[k] === null).map(([, n]) => n);
+}
+
+/** Units consumed, as the bill prints them. */
+export const unitsConsumed = (b: Bill): number => b.units ?? 0;
+
+/** Amount payable, in paise, as the bill prints it. */
+export const amountPayable = (b: Bill): number => b.amountPaise ?? 0;
