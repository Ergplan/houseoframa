+// The bills table: every bill read, kept as printed. With a database the table itself is read (and the
+// sample bill read and written in the first time it is empty); without one, the sample bill is read
+// straight from data/.
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import { desc } from 'drizzle-orm';
+import { readBill, type Bill } from '../features/read-the-bill/read';
+import { database, siteId } from './connect';
+import { bills } from './schema';
+
+export const SAMPLE_BILL = 'data/bill-sep-2026.pdf';
+
+/** The sample bill, read from its file. */
+export function sampleBill(): Bill {
+  return readBill(readFileSync(path.join(process.cwd(), SAMPLE_BILL)));
+}
+
+/** Keeps a bill as a new row, written by whoever read it. */
+export async function keepBill(bill: Bill, readFrom: string, by: string): Promise<void> {
+  const db = database();
+  if (!db) return;
+  await db.insert(bills).values({ siteId: siteId(), createdBy: by, readFrom, ...bill });
+}
+
+/** The newest bill kept; the sample bill when none is kept yet. */
+export async function latestBill(): Promise<Bill> {
+  const db = database();
+  if (!db) return sampleBill();
+  let rows = await db.select().from(bills).orderBy(desc(bills.id)).limit(1);
+  if (rows.length === 0) {
+    await keepBill(sampleBill(), SAMPLE_BILL, 'sample');
+    rows = await db.select().from(bills).orderBy(desc(bills.id)).limit(1);
+  }
+  const r = rows[0]!;
+  return {
+    consumerNo: r.consumerNo,
+    category: r.category,
+    periodFrom: r.periodFrom,
+    periodTo: r.periodTo,
+    units: r.units,
+    amountPaise: r.amountPaise,
+    dueDate: r.dueDate,
+  };
+}
