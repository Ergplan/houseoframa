index 0000000..b8cd2da
--- /dev/null
+++ b/lib/pdf-text.ts
@@ -0,0 +1,47 @@
+// The text of a PDF, as it is printed: every content stream is unpacked (most bills compress theirs)
+// and its text-showing operators are read in order, one line per text position. Enough for a bill made
+// of plain text; a scanned bill (a picture) has no text to read and gives back nothing.
+import { inflateSync } from 'node:zlib';
+
+/** The text of each line of the PDF, top to bottom as written. */
+export function pdfLines(pdf: Buffer): string[] {
+  const raw = pdf.toString('latin1');
+  const lines: string[] = [];
+  const streams = /<<([^>]*(?:>(?!>)[^>]*)*)>>\s*stream\r?\n/g;
+  let m: RegExpExecArray | null;
+  while ((m = streams.exec(raw))) {
+    const start = m.index + m[0].length;
+    const end = raw.indexOf('endstream', start);
+    if (end < 0) break;
+    let body = Buffer.from(raw.slice(start, end).replace(/\r?\n$/, ''), 'latin1');
+    if (/\/FlateDecode/.test(m[1]!)) {
+      try {
+        body = inflateSync(body);
+      } catch {
+        continue;
+      }
+    }
+    lines.push(...textOf(body.toString('latin1')));
+  }
+  return lines.map((l) => l.replace(/\s+/g, ' ').trim()).filter(Boolean);
+}
+
+/** The strings a content stream shows, a new line at each move of the text position. */
+function textOf(content: string): string[] {
+  const out: string[] = [];
+  let line = '';
+  const ops = /\[((?:\([^)\\]*(?:\\.[^)\\]*)*\)|[^\]])*)\]\s*TJ|\(((?:[^)\\]|\\.)*)\)\s*Tj|\b(Td|TD|Tm|T\*|ET)\b/g;
+  let m: RegExpExecArray | null;
+  while ((m = ops.exec(content))) {
+    if (m[3]) {
+      if (line) out.push(line);
+      line = '';
+    } else if (m[2] !== undefined) line += unescape(m[2]);
+    else if (m[1] !== undefined)
+      for (const s of m[1].matchAll(/\(((?:[^)\\]|\\.)*)\)/g)) line += unescape(s[1]!);
+  }
+  if (line) out.push(line);
+  return out;
+}
+
+const unescape = (s: string) => s.replace(/\\([()\\])/g, '$1');
