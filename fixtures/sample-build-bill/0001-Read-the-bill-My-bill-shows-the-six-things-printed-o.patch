+import { readFileSync } from 'node:fs';
+import { expect, it } from 'vitest';
+import { amountPayable, missing, paise, readBill, unitsConsumed } from './read';
+import { pdfLines } from '../../lib/pdf-text';
+
+const sample = readFileSync('data/bill-sep-2026.pdf');
+
+it('reads the six things printed on the sample bill, exactly as printed', () => {
+  expect(readBill(sample)).toEqual({
+    consumerNo: '4123 7788 0021',
+    category: 'Domestic',
+    periodFrom: '01-09-2026',
+    periodTo: '30-09-2026',
+    units: 412,
+    amountPaise: 300300,
+    dueDate: '15-10-2026',
+  });
+  expect(unitsConsumed(readBill(sample))).toBe(412);
+  expect(amountPayable(readBill(sample))).toBe(300300);
+});
+
+it('reads a compressed bill’s text line by line', () => {
+  expect(pdfLines(sample)).toContain('Units consumed 412');
+});
+
+it('keeps an amount in paise, with or without its commas and paise', () => {
+  expect(paise('Rs 3,003.00')).toBe(300300);
+  expect(paise('Rs 45')).toBe(4500);
+  expect(paise('Rs 12.5')).toBe(1250);
+  expect(paise(null)).toBeNull();
+});
+
+it('leaves what is not on the bill empty, and says so', () => {
+  const blank = readBill(Buffer.from('%PDF-1.4\n%%EOF\n'));
+  expect(blank.units).toBeNull();
+  expect(missing(blank)).toEqual([
+    'the consumer number',
+    'the category',
+    'the billing period',
+    'the units consumed',
+    'the amount payable',
+    'the due date',
+  ]);
+  expect(missing(readBill(sample))).toEqual([]);
+});
