--- /dev/null
+++ b/features/count-the-days-takings/takings.test.ts
@@ -0,0 +1,19 @@
+import { expect, it } from 'vitest';
+import { gstOnTakings, todaysTakings } from './takings';
+
+it('adds up every order’s amount', () => {
+  const orders = [
+    { cups: 2, priceOfCup: 1500 },
+    { cups: 1, priceOfCup: 1800 },
+    { cups: 3, priceOfCup: 1500 },
+    { cups: 1, priceOfCup: 2000 },
+  ];
+  expect(todaysTakings(orders)).toBe(11300);
+  expect(todaysTakings([])).toBe(0);
+});
+
+it('works GST out as five percent rounded to the paisa', () => {
+  expect(gstOnTakings(11300)).toBe(565);
+  expect(gstOnTakings(1010)).toBe(51);
+  expect(gstOnTakings(0)).toBe(0);
+});
diff --git a/features/count-the-days-takings/takings.ts b/features/count-the-days-takings/takings.ts
new file mode 100644
index 0000000..1f67662
--- /dev/null
+++ b/features/count-the-days-takings/takings.ts
@@ -0,0 +1,18 @@
+// Count the day's takings: everything the stall took today and the GST owed on it. Pure functions of plain values.
+
+/** The part of an order the takings need. */
+export interface PricedOrder {
+  cups: number;
+  /** The price of one cup, in paise. */
+  priceOfCup: number;
+}
+
+/** Today's takings, in paise: every order's amount (cups times the price of a cup), added up. */
+export function todaysTakings(orders: PricedOrder[]): number {
+  return orders.reduce((sum, order) => sum + order.cups * order.priceOfCup, 0);
+}
+
+/** The GST owed on the day's takings, in paise: five percent, rounded to the paisa. */
+export function gstOnTakings(takings: number): number {
+  return Math.round((takings * 5) / 100);
+}
