+import { Figure } from '../../components/Figure';
+import { todaysOrders } from '../../db/orders';
+import { gstOnTakings, todaysTakings } from '../../features/count-the-days-takings/takings';
+
+export default function TodaysTotal() {
+  const orders = todaysOrders();
+  return (
+    <main>
+      <h1>{'Today’s total'}</h1>
+      <p>
+        {'Today’s takings: '}
+        <Figure id="todays-takings" fn={todaysTakings} args={[orders]} show="rupees" />
+      </p>
+      <p>
+        {'GST on today’s takings: '}
+        <Figure id="gst-on-takings" fn={gstOnTakings} args={[todaysTakings(orders)]} show="rupees" />
+      </p>
+    </main>
+  );
+}
diff --git a/features/count-the-days-takings/takings.test.ts b/features/count-the-days-takings/takings.test.ts
new file mode 100644
