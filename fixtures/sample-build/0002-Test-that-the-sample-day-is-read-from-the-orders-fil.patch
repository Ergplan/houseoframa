Subject: [PATCH 2/4] Test that the sample day is read from the orders file

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 db/orders.test.ts | 14 ++++++++++++++
 1 file changed, 14 insertions(+)
 create mode 100644 db/orders.test.ts

diff --git a/db/orders.test.ts b/db/orders.test.ts
new file mode 100644
index 0000000..61cccca
--- /dev/null
+++ b/db/orders.test.ts
@@ -0,0 +1,14 @@
+import { expect, it } from 'vitest';
+import { todaysOrders } from './orders';
+
+it('reads the sample day: four orders shaped like the orders table', () => {
+  const orders = todaysOrders();
+  expect(orders).toHaveLength(4);
+  expect(orders.map((o) => [o.item, o.cups, o.priceOfCup])).toEqual([
+    ['Masala chai', 2, 1500],
+    ['Ginger chai', 1, 1800],
+    ['Masala chai', 3, 1500],
+    ['Lemon tea', 1, 2000],
+  ]);
+  expect(orders.every((o) => !Number.isNaN(Date.parse(o.takenAt)))).toBe(true);
+});
