@@ -0,0 +1,18 @@
+// See today's orders: how many orders there are and what each one costs. Pure functions of plain values.
+
+/** How many orders were taken today. */
+export function ordersSoFar(orders: unknown[]): number {
+  return orders.length;
+}
+
+/** What one order costs, in paise: cups times the price of a cup. */
+export function orderAmount(cups: number, priceOfCup: number): number {
+  return cups * priceOfCup;
+}
+
+/** @words A small number of cups written in words: "two cups". */
+export function cupsInWords(cups: number): string {
+  const names = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
+  const word = names[cups] ?? 'many';
+  return word + (cups === 1 ? ' cup' : ' cups');
+}
