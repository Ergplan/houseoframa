+// Until a database is connected, the orders are read from data/orders.json, shaped like the orders table.
+import sample from '../data/orders.json';
+
+export interface Order {
+  id: number;
+  item: string;
+  cups: number;
+  /** The price of one cup, in paise. */
+  priceOfCup: number;
+  takenAt: string;
+}
+
+/** Every order the stall has taken today. */
+export function todaysOrders(): Order[] {
+  return sample;
+}
diff --git a/db/schema.ts b/db/schema.ts
index fea6ff1..0b764b8 100644
--- a/db/schema.ts
+++ b/db/schema.ts
@@ -2,10 +2,20 @@
 // product it belongs to, when the row was written and by whom. Spread `provenance()` into each one:
 //
 //   export const orders = pgTable('orders', { id: serial('id').primaryKey(), ...provenance(), … });
-import { text, timestamp } from 'drizzle-orm/pg-core';
+import { integer, pgTable, serial, text, timestamp } from 'drizzle-orm/pg-core';
 
 export const provenance = () => ({
   siteId: text('site_id').notNull(),
   createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
   createdBy: text('created_by').notNull(),
 });
+
+/** The orders the stall has taken: each order's item, cups and price of a cup (in paise), and when it was taken. */
+export const orders = pgTable('orders', {
+  id: serial('id').primaryKey(),
+  ...provenance(),
+  item: text('item').notNull(),
+  cups: integer('cups').notNull(),
+  priceOfCup: integer('price_of_cup').notNull(),
+  takenAt: timestamp('taken_at', { withTimezone: true }).notNull(),
+});
