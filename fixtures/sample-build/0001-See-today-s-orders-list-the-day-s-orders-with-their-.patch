+import { expect, it } from 'vitest';
+import { cupsInWords, orderAmount, ordersSoFar } from './orders';
+
+it('counts the orders', () => {
+  expect(ordersSoFar([{}, {}, {}, {}])).toBe(4);
+  expect(ordersSoFar([])).toBe(0);
+});
+
+it('works an order out as cups times the price of a cup', () => {
+  expect(orderAmount(2, 1500)).toBe(3000);
+  expect(orderAmount(1, 2000)).toBe(2000);
+});
+
+it('says cups in words', () => {
+  expect(cupsInWords(1)).toBe('one cup');
+  expect(cupsInWords(2)).toBe('two cups');
+});
