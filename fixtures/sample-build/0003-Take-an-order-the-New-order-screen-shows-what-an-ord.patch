--- /dev/null
+++ b/features/take-an-order/order.test.ts
@@ -0,0 +1,9 @@
+import { expect, it } from 'vitest';
+import { newOrderAmount } from './order';
+
+it('works out a new order as whole cups times the price of a cup', () => {
+  expect(newOrderAmount(2)).toBe(3000);
+  expect(newOrderAmount(1)).toBe(1500);
+  expect(newOrderAmount(3)).toBe(4500);
+  expect(newOrderAmount(2.9)).toBe(3000);
+});
diff --git a/features/take-an-order/order.ts b/features/take-an-order/order.ts
new file mode 100644
index 0000000..68ee429
--- /dev/null
+++ b/features/take-an-order/order.ts
@@ -0,0 +1,12 @@
+// Take an order: what a new order will cost before it is saved.
+
+/** The price of a cup of Masala chai, in paise. */
+export const PRICE_OF_A_CUP_PAISE = 1500;
+
+/** The cups chosen when the page opens. */
+export const STARTING_CUPS = 2;
+
+/** What a new order will cost, in paise: whole cups times the price of a cup. */
+export function newOrderAmount(cups: number): number {
+  return Math.floor(cups) * PRICE_OF_A_CUP_PAISE;
+}
