+import { renderToStaticMarkup } from 'react-dom/server';
+import { expect, it } from 'vitest';
+import NewOrder from './page';
+
+it('shows the new order form with its amount for two cups', () => {
+  const html = renderToStaticMarkup(<NewOrder />);
+  expect(html).toContain('New order');
+  expect(html).toContain('Masala chai');
+  expect(html).toContain('one cup');
+  expect(html).toContain('two cups');
+  expect(html).toContain('three cups');
+  expect(html).toContain('Take the order');
+  expect(html).toContain('data-rama-figure="new-order-amount"');
+  expect(html).toContain('data-rama-value="3000"');
+  expect(html).toContain('₹30.00');
+});
