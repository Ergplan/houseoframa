+import { Figure } from '../../components/Figure';
+import { STARTING_CUPS, newOrderAmount } from '../../features/take-an-order/order';
+
+export default function NewOrder() {
+  return (
+    <main>
+      <h1>{'New order'}</h1>
+      <form>
+        <p>
+          <label>
+            Item{' '}
+            <select name="item" defaultValue="Masala chai">
+              <option value="Masala chai">Masala chai</option>
+            </select>
+          </label>
+        </p>
+        <p>
+          <label>
+            Cups{' '}
+            <select name="cups" defaultValue="2">
+              <option value="1">one cup</option>
+              <option value="2">two cups</option>
+              <option value="3">three cups</option>
+            </select>
+          </label>
+        </p>
+        <p>
+          New order amount:{' '}
+          <Figure id="new-order-amount" fn={newOrderAmount} args={[STARTING_CUPS]} show="rupees" />
+        </p>
+        <button type="button">Take the order</button>
+      </form>
+    </main>
+  );
+}
diff --git a/features/take-an-order/order.test.ts b/features/take-an-order/order.test.ts
