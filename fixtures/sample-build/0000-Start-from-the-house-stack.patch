+        ts.isPropertyAccessExpression(callee) &&
+        NUMBER_TO_TEXT.has(callee.name.text) &&
+        isNumber(callee.expression)
+      )
+        return `the number “${callee.expression.getText().slice(0, 40)}” written as text`;
