+# Every push: the figures lint (no number on a screen without its Figure), the tests and the build.
+# The merge gate (rama-gate.yml) is the other workflow: nothing merges unsigned.
+name: build
+
+on: [push, pull_request]
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - run: npm install --no-audit --no-fund
+      - run: npm run lint:figures
+      - run: npm test
+      - run: npm run build
diff --git a/.github/workflows/rama-gate.yml b/.github/workflows/rama-gate.yml
new file mode 100644
index 0000000..ee09eae
--- /dev/null
+++ b/.github/workflows/rama-gate.yml
@@ -0,0 +1,101 @@
+# House of Rama merge gate (Invariant 4: nothing merges unsigned). Copied into a target's
+# .github/workflows/ from github.com/Ergplan/houseoframa packages/ceremony/ci/rama-gate.yml.
+#
+# It runs on pull_request_target, so the version of this file that judges a pull request is the one on
+# the base branch: a pull request cannot edit or switch off the gate that judges it. Two jobs on two
+# runners keep the target's code away from the gate:
+#   tests  runs the pull request's tests (its code) for a report, with a read-only token, no secrets and
+#          no House of Rama checkout; whatever it does, it ends on its own runner;
+#   gate   never runs the target's code: it checks the pull request out as data, runs House of Rama's
+#          gate at a pinned ref, and reads the report as a list of passed test files, nothing more.
+# The gate reads no configuration from the target. Make "rama gate" a required check in the branch
+# protection rules; that setting lives outside the repository's files.
+name: rama gate
+
+on:
+  pull_request_target:
+    types: [opened, synchronize, reopened]
+
+permissions:
+  contents: read
+
+jobs:
+  tests:
+    name: target tests (report only)
+    runs-on: ubuntu-latest
+    continue-on-error: true
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          persist-credentials: false
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - run: npm ci
+      - run: npx vitest run --project unit --reporter=json --outputFile=rama-tests.json
+      - name: Name each test file by its repository path (the gate job checks the target out elsewhere)
+        if: ${{ !cancelled() }}
+        run: >
+          node -e 'const fs = require("fs"), path = require("path");
+          if (!fs.existsSync("rama-tests.json")) process.exit(0);
+          const r = JSON.parse(fs.readFileSync("rama-tests.json", "utf8"));
+          for (const t of r.testResults ?? []) t.name = path.relative(process.cwd(), t.name).split(path.sep).join("/");
+          fs.writeFileSync("rama-tests.json", JSON.stringify(r));'
+      - uses: actions/upload-artifact@v4
+        if: ${{ !cancelled() }}
+        with:
+          name: rama-tests
+          path: rama-tests.json
+          if-no-files-found: ignore
+
+  gate:
+    name: rama gate
+    needs: tests
+    if: ${{ !cancelled() }}
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check out the pull request as data (full history, no credentials kept)
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+          path: target
+
+      - name: Check out House of Rama at a pinned ref
+        uses: actions/checkout@v4
+        with:
+          repository: Ergplan/houseoframa
+          ref: ca547bb8a2a3ee458f8860af7c1604d1baefaa45
+          persist-credentials: false
+          path: rama
+
+      - uses: pnpm/action-setup@v4
+        with:
+          version: 10
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+
+      - name: Install House of Rama
+        run: pnpm --dir rama install --frozen-lockfile
+
+      - name: Fetch the test report (absent when the tests job wrote none)
+        uses: actions/download-artifact@v4
+        continue-on-error: true
+        with:
+          name: rama-tests
+          path: ${{ runner.temp }}/report
+
+      - name: Gate
+        env:
+          BASE: ${{ github.event.pull_request.base.sha }}
+          REPORT: ${{ runner.temp }}/report/rama-tests.json
+          # House of Rama's public key: a signature counts only when its seal verifies against it. Written
+          # here by `rama-ceremony install-gate`; this copy of the file is the base branch's.
+          PUBLIC_KEY: 'MCowBQYDK2VwAyEA1X5IabH2cgLbEObvCSYftXcP/ghr8arK72f6x3v6HKs='
+        run: |
+          if [ -f "$REPORT" ]; then set -- --test-report "$REPORT"; fi
+          if [ -n "$PUBLIC_KEY" ]; then set -- "$@" --public-key "$PUBLIC_KEY"; fi
+          pnpm --dir rama rama gate "$GITHUB_WORKSPACE/target" --base "$BASE" "$@"
