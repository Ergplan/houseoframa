@@ -0,0 +1,28 @@
+// A figure on a screen (docs/HOUSE-STYLE.md): it works its value out by calling the figure's own
+// function with the arguments given, and shows that result. So what a person reads is always what the
+// function says; it marks the element with the figure's id, the arguments and the raw value, so House of
+// Rama can trace it and work it out again. rama/figures.ts is read as a type only: a screen carries the
+// code of its own figures and no other.
+import type { figures } from '../rama/figures';
+import { SHOW } from '../rama/define';
+
+type Figures = typeof figures;
+
+export function Figure<K extends keyof Figures & string>(props: {
+  id: K;
+  /** The same function rama/figures.ts names for this id (rama/lint.ts checks). */
+  fn: Figures[K]['fn'];
+  args: Parameters<Figures[K]['fn']>;
+  show: Figures[K]['show'];
+}) {
+  const value = (props.fn as (...a: unknown[]) => number)(...props.args);
+  return (
+    <span
+      data-rama-figure={props.id}
+      data-rama-args={JSON.stringify(props.args)}
+      data-rama-value={String(value)}
+    >
+      {SHOW[props.show](value)}
+    </span>
+  );
+}
diff --git a/db/connect.ts b/db/connect.ts
new file mode 100644
index 0000000..3977a00
--- /dev/null
+++ b/db/connect.ts
@@ -0,0 +1,19 @@
+// The product's own database. House of Rama hands the running app DATABASE_URL (a database for this
+// product alone) and RAMA_SITE_ID (the product's id, for each row's site_id). Without them (the tests,
+// `next build`) `database()` is null and a building reads its sample rows from data/<table>.json.
+import { drizzle, type PostgresJsDatabase } from 'drizzle-orm/postgres-js';
+import postgres from 'postgres';
+import * as schema from './schema';
+
+let db: PostgresJsDatabase<typeof schema> | undefined;
+
+/** The database, or null when none is connected. */
+export function database(): PostgresJsDatabase<typeof schema> | null {
+  const url = process.env.DATABASE_URL;
+  if (!url) return null;
+  db ??= drizzle(postgres(url, { max: 3 }), { schema });
+  return db;
+}
+
+/** The product's id, written into each row's site_id. */
+export const siteId = (): string => process.env.RAMA_SITE_ID ?? 'this-product';
diff --git a/db/schema.ts b/db/schema.ts
new file mode 100644
index 0000000..fea6ff1
--- /dev/null
+++ b/db/schema.ts
@@ -0,0 +1,11 @@
+// The product's tables, in Drizzle (the ground of the Street). Every table carries its provenance: the
+// product it belongs to, when the row was written and by whom. Spread `provenance()` into each one:
+//
+//   export const orders = pgTable('orders', { id: serial('id').primaryKey(), ...provenance(), … });
+import { text, timestamp } from 'drizzle-orm/pg-core';
+
+export const provenance = () => ({
+  siteId: text('site_id').notNull(),
+  createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
+  createdBy: text('created_by').notNull(),
+});
