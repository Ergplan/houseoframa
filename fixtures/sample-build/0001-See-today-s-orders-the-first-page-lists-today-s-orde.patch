@@ -0,0 +1,22 @@
+// See today's orders: what each order costs and how many orders there are.
+import type { Order } from '../../db/orders';
+
+/** How many orders the stall has taken today. */
+export function orderCount(orders: Order[]): number {
+  return orders.length;
+}
+
+/** What one order costs, in paise: its cups times the price of a cup. */
+export function orderAmount(cups: number, pricePaise: number): number {
+  return cups * pricePaise;
+}
+
+/**
+ * A small count of cups, in words ("two cups").
+ * @words
+ */
+export function cupsInWords(cups: number): string {
+  const names = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
+  const word = names[cups] ?? 'many';
+  return word + (cups === 1 ? ' cup' : ' cups');
+}
