+import { expect, it } from 'vitest';
+import { cupsInWords, orderAmount, orderCount } from './orders';
+
+const order = { item: 'Lemon tea', cups: 1, pricePaise: 2000, takenAt: '2026-10-28T09:45:00+05:30' };
+
+it('counts the orders', () => {
+  expect(orderCount([order, order])).toBe(2);
+  expect(orderCount([])).toBe(0);
+});
+
+it('multiplies cups by the price of a cup', () => {
+  expect(orderAmount(2, 1500)).toBe(3000);
+  expect(orderAmount(1, 1800)).toBe(1800);
+});
+
+it('says cups in words', () => {
+  expect(cupsInWords(1)).toBe('one cup');
+  expect(cupsInWords(2)).toBe('two cups');
+});
