+// The orders table: the stall keeps one day, so every order in it is today's. With a database the table
+// itself is read (and the sample day written in the first time it is empty); without one, data/orders.json.
+import sample from '../data/orders.json';
+import { database, siteId } from './connect';
+import { orders } from './schema';
+
+export interface Order {
+  item: string;
+  cups: number;
+  /** Price of one cup, in paise. */
+  pricePaise: number;
+  takenAt: string;
+}
+
+/** Every order the stall has taken today. */
+export async function listOrders(): Promise<Order[]> {
+  const db = database();
+  if (!db) return sample;
+  let rows = await db.select().from(orders);
+  if (rows.length === 0) {
+    await db.insert(orders).values(
+      sample.map((o) => ({
+        siteId: siteId(),
+        createdBy: 'sample',
+        item: o.item,
+        cups: o.cups,
+        pricePaise: o.pricePaise,
+        takenAt: new Date(o.takenAt),
+      })),
+    );
+    rows = await db.select().from(orders);
+  }
+  return rows.map((r) => ({
+    item: r.item,
+    cups: r.cups,
+    pricePaise: r.pricePaise,
+    takenAt: r.takenAt.toISOString(),
+  }));
+}
