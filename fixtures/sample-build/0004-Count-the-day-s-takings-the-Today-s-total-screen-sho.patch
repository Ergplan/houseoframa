+import { renderToStaticMarkup } from 'react-dom/server';
+import { expect, it } from 'vitest';
+import TodaysTotal from './page';
+
+it('shows the day’s takings and the GST on them for the sample day', async () => {
+  const html = renderToStaticMarkup(await TodaysTotal());
+  expect(html).toContain('Today’s total');
+  expect(html).toContain('data-rama-figure="todays-takings"');
+  expect(html).toContain('data-rama-value="11300"');
+  expect(html).toContain('₹113.00');
+  expect(html).toContain('data-rama-figure="gst-on-todays-takings"');
+  expect(html).toContain('data-rama-value="565"');
+  expect(html).toContain('₹5.65');
+});
diff --git a/app/total/page.tsx b/app/total/page.tsx
new file mode 100644
index 0000000..46e2f5e
--- /dev/null
+++ b/app/total/page.tsx
@@ -0,0 +1,21 @@
+import { Figure } from '../../components/Figure';
+import { listOrders } from '../../db/orders';
+import { gstOnTakings, todaysTakings } from '../../features/count-the-days-takings/takings';
+
+export const dynamic = 'force-dynamic';
+
+export default async function TodaysTotal() {
+  const orders = await listOrders();
+  return (
+    <main>
+      <h1>{'Today’s total'}</h1>
+      <p>
+        Today’s takings: <Figure id="todays-takings" fn={todaysTakings} args={[orders]} show="rupees" />
+      </p>
+      <p>
+        GST on today’s takings:{' '}
+        <Figure id="gst-on-todays-takings" fn={gstOnTakings} args={[orders]} show="rupees" />
+      </p>
+    </main>
+  );
+}
diff --git a/features/count-the-days-takings/takings.test.ts b/features/count-the-days-takings/takings.test.ts
new file mode 100644
index 0000000..532d2ed
--- /dev/null
+++ b/features/count-the-days-takings/takings.test.ts
@@ -0,0 +1,21 @@
+import { expect, it } from 'vitest';
+import { gstOnTakings, todaysTakings } from './takings';
+
+const at = '2026-10-28T09:00:00+05:30';
+const sampleDay = [
+  { item: 'Masala chai', cups: 2, pricePaise: 1500, takenAt: at },
+  { item: 'Ginger chai', cups: 1, pricePaise: 1800, takenAt: at },
+  { item: 'Masala chai', cups: 3, pricePaise: 1500, takenAt: at },
+  { item: 'Lemon tea', cups: 1, pricePaise: 2000, takenAt: at },
+];
+
+it('adds up every order’s amount', () => {
+  expect(todaysTakings(sampleDay)).toBe(11300);
+  expect(todaysTakings([])).toBe(0);
+});
+
+it('works out five percent GST, rounded to the paisa', () => {
+  expect(gstOnTakings(sampleDay)).toBe(565);
+  expect(gstOnTakings([{ item: 'Tea', cups: 1, pricePaise: 1010, takenAt: at }])).toBe(51);
+  expect(gstOnTakings([])).toBe(0);
+});
diff --git a/features/count-the-days-takings/takings.ts b/features/count-the-days-takings/takings.ts
new file mode 100644
index 0000000..2ccb344
--- /dev/null
+++ b/features/count-the-days-takings/takings.ts
@@ -0,0 +1,15 @@
+// Count the day's takings: everything the stall took today and the GST owed on it.
+import type { Order } from '../../db/orders';
+
+/** Five percent GST, as a share of the takings. */
+const GST_PERCENT = 5;
+
+/** Today's takings, in paise: every order's amount (cups times the price of a cup), added up. */
+export function todaysTakings(orders: Order[]): number {
+  return orders.reduce((sum, o) => sum + o.cups * o.pricePaise, 0);
+}
+
+/** The GST owed on today's takings, in paise: five percent, rounded to the paisa. */
+export function gstOnTakings(orders: Order[]): number {
+  return Math.round((todaysTakings(orders) * GST_PERCENT) / 100);
+}
