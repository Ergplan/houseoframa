+import { expect, it } from 'vitest';
+import { cupChoice, newOrderAmount, PRICE_OF_CUP } from './order';
+
+it('works a new order out as whole cups times the price of a cup', () => {
+  expect(PRICE_OF_CUP).toBe(1500);
+  expect(newOrderAmount(1)).toBe(1500);
+  expect(newOrderAmount(2)).toBe(3000);
+  expect(newOrderAmount(3)).toBe(4500);
+  expect(newOrderAmount(2.7)).toBe(3000);
+});
+
+it('says the cups to choose from in words', () => {
+  expect(cupChoice(1)).toBe('one cup');
+  expect(cupChoice(3)).toBe('three cups');
+});
