@@ -0,0 +1,15 @@
+// Take an order: what a new order will cost before it is saved. Pure functions of plain values.
+
+/** The price of one cup of Masala chai, in paise. */
+export const PRICE_OF_CUP = 1500;
+
+/** What a new order will cost, in paise: whole cups times the price of a cup. */
+export function newOrderAmount(cups: number): number {
+  return Math.floor(cups) * PRICE_OF_CUP;
+}
+
+/** @words The cups one can choose from, written in words: "two cups". */
+export function cupChoice(cups: number): string {
+  const names = ['no', 'one', 'two', 'three'];
+  return (names[cups] ?? 'many') + (cups === 1 ? ' cup' : ' cups');
+}
