# Copy to .env. Never commit .env.
DATABASE_URL=postgres://rama:rama@localhost:5432/rama
# The builder and the auditor must be different vendors (Invariant 5): anthropic | openai.
BUILDER_VENDOR=anthropic
AUDITOR_VENDOR=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model per vendor. ANTHROPIC_MODEL defaults to claude-sonnet-5-5. OPENAI_MODEL has no code default; the member chose gpt-6.1-sol (DECISIONS 2026-10-20).
ANTHROPIC_MODEL=
OPENAI_MODEL=gpt-6.1-sol
# The single local member until Stage 6; the seed creates this person.
RAMA_MEMBER_NAME=
# Short SHA shown on the home page. `pnpm dev` fills it from git when empty.
GIT_SHA=
