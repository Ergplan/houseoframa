# Copy to .env. Never commit .env.
DATABASE_URL=postgres://rama:rama@localhost:5432/rama
# The builder and the auditor must be different vendors (Invariant 5): anthropic | openai.
BUILDER_VENDOR=anthropic
AUDITOR_VENDOR=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model per vendor. ANTHROPIC_MODEL defaults to claude-sonnet-5-5. OPENAI_MODEL has no code default; the member chose gpt-6.1-sol (DECISIONS 2026-10-20).
ANTHROPIC_MODEL=
OPENAI_MODEL=gpt-6.1-sol
# The first member: the seed creates this person and gives them the site "self". From Stage 6 members
# sign in by email link: `pnpm rama-member add <email> <name>`, then `pnpm rama-member link <email>`.
RAMA_MEMBER_NAME=
# The app's public address, used in sign-in links (default: the request's own origin).
RAMA_BASE_URL=
# Mail for sign-in links: smtp[s]://user:pass@host:port. Unset, links go to the server log (the outbox).
SMTP_URL=
MAIL_FROM=
# Short SHA shown on the home page. `pnpm dev` fills it from git when empty.
GIT_SHA=
