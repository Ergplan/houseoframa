# Copy to .env. Never commit .env.
DATABASE_URL=postgres://rama:rama@localhost:5432/rama
# The builder and the auditor must be different vendors (Invariant 5): anthropic | openai.
BUILDER_VENDOR=anthropic
AUDITOR_VENDOR=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model per vendor. ANTHROPIC_MODEL defaults to claude-sonnet-5-5. OPENAI_MODEL has no code default; the member chose gpt-6.1-sol (DECISIONS 2026-10-20).
ANTHROPIC_MODEL=
OPENAI_MODEL=gpt-6.1-sol
# For engineers and CI only: who owns what the seed and the command line add. Unset, the first trainer in
# members.json does.
RAMA_MEMBER_NAME=
# People pick their names from members.json (version 1, no passwords). The floor edition's sign-in by
# username and password is switched on with AUTH_MODE=password and RAMA_ACCOUNTS, a JSON list in single
# quotes: '[{"username":"…","password":"<8+ chars>","name":"…","role":"manager"}]'. Leave both unset.
AUTH_MODE=
RAMA_ACCOUNTS=
# The app's public address, for redirects after sign-in (default: the request's own origin).
RAMA_BASE_URL=
# Short SHA shown on the home page. `pnpm dev` fills it from git when empty.
GIT_SHA=
# The pod controller's bearer token for GET /api/pod/<n>/status. Unset, that route answers 503.
RAMA_POD_TOKEN=
# House of Rama's Ed25519 key for sealing signatures (secret): `pnpm rama-ceremony signing-key` writes one here
# and prints the public key, which `rama-ceremony install-gate` puts in a target's gate workflow.
RAMA_SIGNING_KEY=
