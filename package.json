{
  "name": "house-of-rama",
  "private": true,
  "version": "0.0.1",
  "description": "House of Rama — Built on trust. Agent-built software your whole company can watch, question and sign off.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "watch": "node scripts/watch.mjs",
    "check": "node scripts/watch.mjs --once",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @rama/db migrate",
    "db:seed": "pnpm --filter @rama/db seed",
    "db:generate": "pnpm --filter @rama/db generate",
    "gen:blueprint-doc": "node scripts/gen-blueprint-doc.mjs",
    "extract:self": "rama site extract self",
    "check:self": "rama site check self",
    "rama": "rama",
    "review": "tsx scripts/review.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@rama/blueprint": "workspace:*",
    "@rama/db": "workspace:^",
    "@rama/model": "workspace:*",
    "@rama/shared": "workspace:^",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "postgres": "3.4.9",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
